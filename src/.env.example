# =============================================================================
# .env.example — copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is protected by .gitignore
#
# The application runs fully offline in local mode without IBM credentials.
# Set AI_MODE=watsonx only when you have valid IBM watsonx.ai credentials.
# =============================================================================

# ── AI Inference Mode ─────────────────────────────────────────────────────────
# Options: "local" (default, no credentials required) | "watsonx" (IBM Granite)
AI_MODE=local

# ── IBM watsonx.ai (required only when AI_MODE=watsonx) ──────────────────────
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Database ──────────────────────────────────────────────────────────────────
# Local development — SQLite file written next to this .env:
DATABASE_URL=sqlite:///./emergency.db
#
# Render deployment — use a Persistent Disk mounted at /var/data
# (note the four slashes after sqlite:)
# DATABASE_URL=sqlite:////var/data/emergency.db

# ── Application ───────────────────────────────────────────────────────────────
PORT=8000
SIMILARITY_THRESHOLD=0.55

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
# Local development — allow the Vite dev server:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
#
# Render deployment — replace with your actual deployed frontend URL:
# CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
